{
  "name": "slop-drift-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + Durable Objects + D1 backend for Slop Drift multiplayer and leaderboards",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply slop-drift --local",
    "db:remote": "wrangler d1 migrations apply slop-drift --remote"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  }
}
